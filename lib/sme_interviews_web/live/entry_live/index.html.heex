<.h1>Listing Entries</.h1>

<%= if @speaking? do %>
  <Heroicons.Solid.chat_alt class="w-6 h-6 text-green-500" />
<% else %>
  <Heroicons.Solid.dots_horizontal class="w-6 h-6 text-gray-500" />
<% end %>

<div
  id="transcriber"
  phx-hook="Transcriber"
  data-model-file="model.tflite"
  data-model-version="0.0"
  data-model-url={@model_url}
>
  <div id="model-data" data-file-name="model.tflite" data-version="1.0" data-url={@model_url} />
  <div id="scorer-data" data-file-name="model.scorer" data-version="0.0" data-url={@scorer_url} />
</div>
<div id="voice-detector" phx-hook="VoiceDetector"></div>

<%= if @live_action in [:new, :edit] do %>
  <.modal title={@page_title} return_to={Routes.entry_index_path(@socket, :index)}>
    <.live_component
      module={SmeInterviewsWeb.EntryLive.FormComponent}
      id={@entry.id || :new}
      action={@live_action}
      entry={@entry}
      return_to={Routes.entry_index_path(@socket, :index)}
    />
  </.modal>
<% end %>

<table>
  <thead>
    <tr>
      <th>From</th>
      <th>To</th>
      <th>Text</th>
      <th>Status</th>

      <th></th>
    </tr>
  </thead>
  <tbody id="entries">
    <%= for entry <- @entries do %>
      <tr id={"entry-#{entry.id}"}>
        <td><%= entry.from %></td>
        <td><%= entry.to %></td>
        <td><%= entry.text %></td>
        <td><%= entry.status %></td>
        <audio src={entry.get_url} controls crossorigin />

        <td>
          <span>
            <%= live_redirect("Show", to: Routes.entry_show_path(@socket, :show, entry)) %>
          </span>
          <span>
            <%= live_patch("Edit", to: Routes.entry_index_path(@socket, :edit, entry)) %>
          </span>
          <span>
            <%= link("Delete",
              to: "#",
              phx_click: "delete",
              phx_value_id: entry.id,
              data: [confirm: "Are you sure?"]
            ) %>
          </span>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<span><%= live_patch("New Entry", to: Routes.entry_index_path(@socket, :new)) %></span>
