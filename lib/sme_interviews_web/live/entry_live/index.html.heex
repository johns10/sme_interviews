<h1>Listing Entries</h1>

<%= if @live_action in [:new, :edit] do %>
  <.modal title={@page_title} return_to={Routes.entry_index_path(@socket, :index)}>
    <.live_component
      module={SmeInterviewsWeb.EntryLive.FormComponent}
      id={@entry.id || :new}
      action={@live_action}
      entry={@entry}
      return_to={Routes.entry_index_path(@socket, :index)}
    />
  </.modal>
<% end %>

<table>
  <thead>
    <tr>
      <th>From</th>
      <th>To</th>
      <th>Text</th>

      <th></th>
    </tr>
  </thead>
  <tbody id="entries">
    <%= for entry <- @entries do %>
      <tr id={"entry-#{entry.id}"}>
        <td><%= entry.from %></td>
        <td><%= entry.to %></td>
        <td><%= entry.text %></td>

        <td>
          <span>
            <%= live_redirect("Show", to: Routes.entry_show_path(@socket, :show, entry)) %>
          </span>
          <span>
            <%= live_patch("Edit", to: Routes.entry_index_path(@socket, :edit, entry)) %>
          </span>
          <span>
            <%= link("Delete",
              to: "#",
              phx_click: "delete",
              phx_value_id: entry.id,
              data: [confirm: "Are you sure?"]
            ) %>
          </span>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<span><%= live_patch("New Entry", to: Routes.entry_index_path(@socket, :new)) %></span>
